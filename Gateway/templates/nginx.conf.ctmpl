events {}

http {
    upstream users_pool {
        {{range service "users-service"}}
        server {{.Address}}:{{.Port}} max_fails=3 fail_timeout=10s;
        {{else}}
        # Servidor de respaldo si no hay instancias saludables
        server 127.0.0.1:8080 down;
        {{end}}
    }

    upstream auth_pool {
        {{range service "auth-service"}}
        server {{.Address}}:{{.Port}} max_fails=3 fail_timeout=10s;
        {{else}}
        server 127.0.0.1:8080 down;
        {{end}}
    }

    upstream logs_pool {
        {{range service "logs-service"}}
        server {{.Address}}:{{.Port}} max_fails=3 fail_timeout=10s;
        {{else}}
        server 127.0.0.1:8080 down;
        {{end}}
    }

    upstream users_grpc_pool {
        {{range service "users-grpc-service"}}
        server {{.Address}}:{{.Port}} max_fails=3 fail_timeout=10s;
        {{else}}
        server 127.0.0.1:50051 down;
        {{end}}
    }

    upstream auth_grpc_pool {
        {{range service "auth-grpc-service"}}
        server {{.Address}}:{{.Port}} max_fails=3 fail_timeout=10s;
        {{else}}
        server 127.0.0.1:50051 down;
        {{end}}
    }

    upstream logs_grpc_pool {
        {{range service "logs-grpc-service"}}
        server {{.Address}}:{{.Port}} max_fails=3 fail_timeout=10s;
        {{else}}
        server 127.0.0.1:50051 down;
        {{end}}
    }

    server {
        listen 8080;

        location /auth/ {
            proxy_pass http://auth_pool/;
                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /users/ {
            proxy_pass http://users_pool/;
                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /logs/ {
            proxy_pass http://logs_pool/;
                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /heartbeat {
            add_header Content-Type text/plain;
            return 200 "nginx gateway alive";
        }
    }

    server {
        listen 50051 http2;

        location /auth.v1.AuthService/ {
            grpc_pass grpc://auth_grpc_pool;
            grpc_set_header Host $host;
            grpc_set_header X-Real-IP $remote_addr;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            grpc_set_header X-Forwarded-Proto $scheme;
        }

        location /users.v1.UsersService/ {
            grpc_pass grpc://users_grpc_pool;
            grpc_set_header Host $host;
            grpc_set_header X-Real-IP $remote_addr;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            grpc_set_header X-Forwarded-Proto $scheme;
        }

        location /logs.v1.LogsService/ {
            grpc_pass grpc://logs_grpc_pool;
            grpc_set_header Host $host;
            grpc_set_header X-Real-IP $remote_addr;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            grpc_set_header X-Forwarded-Proto $scheme;
        }
    }
}